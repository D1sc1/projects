<Window x:Class="LightsOutGame.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LightsOutGame.Wpf" xmlns:viewmodels="clr-namespace:LightsOutGame.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Светильники (Lights Out)" Height="680" Width="650" MinHeight="680" MinWidth="600" Background="#1E1E24">
    <Window.DataContext>
        <viewmodels:MainWindowViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="1" Grid.Column="1" Text="СВЕТИЛЬНИКИ" FontSize="24" FontWeight="Bold"
                   Foreground="#FFD166" HorizontalAlignment="Center" Margin="5" />

        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Количество ходов: " Margin="5" FontSize="18" Foreground="White" />
            <TextBlock Text="{Binding MoveCount}" Margin="5" FontSize="18" Foreground="White" />
        </StackPanel>

        <ItemsControl Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Cells}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="100" />
                            <RowDefinition Height="100" />
                            <RowDefinition Height="100" />
                            <RowDefinition Height="100" />
                            <RowDefinition Height="100" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid MouseDown="Grid_MouseDown" Tag="{Binding}" Cursor="Hand">
                        <Rectangle Margin="5" Stroke="#3D3D4A" StrokeThickness="3" RadiusX="10" RadiusY="10">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Fill" Value="#FF3D3D4A" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOn}" Value="True">
                                            <Setter Property="Fill" Value="#FFFFD066" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>

            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Grid.Row" Value="{Binding Row}" />
                    <Setter Property="Grid.Column" Value="{Binding Column}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <Button Grid.Row="4" Grid.Column="1" Content="Новая игра" Click="NewGameButton_Click"
                Padding="15,8" Margin="10" FontSize="16" Background="#EF476F" Foreground="White"
                FontWeight="Bold" HorizontalAlignment="Center" Cursor="Hand" />
    </Grid>
</Window>
